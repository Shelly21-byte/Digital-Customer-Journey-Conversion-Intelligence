      {
        "name": "KPI Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "a7f9675f-ebdf-40aa-a895-d21e4e025faa",
            "sourceColumn": "Placeholder",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "6982b34d-d22b-427c-b317-63d5a0b56592",
        "measures": [
          {
            "name": "Total Sessions",
            "description": "Total Sessions",
            "displayFolder": "01 Executive",
            "expression": "COUNTROWS(Sessions)",
            "formatString": "#,0",
            "lineageTag": "4bb3b07a-e0bb-4753-8fc1-7cabddd1ada0"
          },
          {
            "name": "Total Visitors",
            "description": "Total Visitors",
            "displayFolder": "01 Executive",
            "expression": "DISTINCTCOUNT(Sessions[visitor_id])",
            "formatString": "#,0",
            "lineageTag": "26f90087-8989-4a44-9326-6c3e1db1735d"
          },
          {
            "name": "Total Orders",
            "description": "Total Orders",
            "displayFolder": "01 Executive",
            "expression": "CALCULATE(COUNTROWS(Orders), Orders[order_status] = \"Completed\")",
            "formatString": "#,0",
            "lineageTag": "e07da7bc-89b4-4490-bdcd-49c9bd500e45"
          },
          {
            "name": "Total Revenue",
            "description": "Total Revenue",
            "displayFolder": "01 Executive",
            "expression": "CALCULATE(SUM(Orders[order_value_inr]), Orders[order_status] = \"Completed\")",
            "formatString": "\"₹\"#,0;(\"₹\"#,0);\"₹\"0",
            "lineageTag": "a5e67c86-f61e-4c25-8a7b-2570af1dac58"
          },
          {
            "name": "Purchasing Sessions",
            "description": "Purchasing Sessions",
            "displayFolder": "01 Executive",
            "expression": "SUM(Sessions[purchase_flag])",
            "formatString": "#,0",
            "lineageTag": "b4bc8065-0ddc-46ff-b235-916fb6b7dde5"
          },
          {
            "name": "Conversion Rate",
            "description": "Conversion Rate",
            "displayFolder": "01 Executive",
            "expression": "DIVIDE([Purchasing Sessions], [Total Sessions])",
            "formatString": "0.00%",
            "lineageTag": "009b1c8a-3d44-4b66-bba5-d6a0fe8f9a19"
          },
          {
            "name": "Average Order Value",
            "description": "Average Order Value",
            "displayFolder": "01 Executive",
            "expression": "DIVIDE([Total Revenue], [Total Orders])",
            "formatString": "\"₹\"#,0.00",
            "lineageTag": "0050f66f-444e-45e5-83b0-0e7c4e563883"
          },
          {
            "name": "Revenue per Session",
            "description": "Revenue per Session",
            "displayFolder": "01 Executive",
            "expression": "DIVIDE([Total Revenue], [Total Sessions])",
            "formatString": "\"₹\"#,0.00",
            "lineageTag": "33f898e9-0db7-4a97-a237-09b96034e9bd"
          },
          {
            "name": "Revenue per Visitor",
            "description": "Revenue per Visitor",
            "displayFolder": "01 Executive",
            "expression": "DIVIDE([Total Revenue], [Total Visitors])",
            "formatString": "\"₹\"#,0.00",
            "lineageTag": "e7571d86-3bb0-43dc-98af-27ed1f34d98c"
          },
          {
            "name": "Engaged Sessions",
            "description": "Engaged Sessions",
            "displayFolder": "01 Executive",
            "expression": "SUM(Sessions[engaged_flag])",
            "formatString": "#,0",
            "lineageTag": "6dfe219a-3d26-4ec9-b019-2bcd78ca021b"
          },
          {
            "name": "Engagement Rate",
            "description": "Duration >10 seconds OR >=2 page views OR purchase; saturated in supplied synthetic data.",
            "displayFolder": "01 Executive",
            "expression": "DIVIDE([Engaged Sessions], [Total Sessions])",
            "formatString": "0.00%",
            "lineageTag": "59386114-e8d1-41d1-83a1-156b4d26e21e"
          },
          {
            "name": "Average Session Minutes",
            "description": "Average Session Minutes",
            "displayFolder": "04 Behavior",
            "expression": "DIVIDE(AVERAGE(Sessions[duration_seconds]), 60)",
            "formatString": "0.0",
            "lineageTag": "7631c5a2-e8ff-44b7-82ab-5b81ced4f487"
          },
          {
            "name": "Pages per Session",
            "description": "Pages per Session",
            "displayFolder": "04 Behavior",
            "expression": "AVERAGE(Sessions[page_views])",
            "formatString": "0.00",
            "lineageTag": "42d2af28-221b-4b04-a397-ba2e0f44c9fb"
          },
          {
            "name": "New Visitor Sessions",
            "description": "New Visitor Sessions",
            "displayFolder": "04 Behavior",
            "expression": "CALCULATE([Total Sessions], KEEPFILTERS(Sessions[user_type] = \"New\"))",
            "formatString": "#,0",
            "lineageTag": "ddd3fd7f-6a02-415d-998c-877e7553b580"
          },
          {
            "name": "Returning Sessions",
            "description": "Returning Sessions",
            "displayFolder": "04 Behavior",
            "expression": "CALCULATE([Total Sessions], KEEPFILTERS(Sessions[user_type] = \"Returning\"))",
            "formatString": "#,0",
            "lineageTag": "45670ce0-748f-46fb-b692-79f876916a32"
          },
          {
            "name": "Returning Session Share",
            "description": "Returning Session Share",
            "displayFolder": "04 Behavior",
            "expression": "DIVIDE([Returning Sessions], [Total Sessions])",
            "formatString": "0.0%",
            "lineageTag": "a2aa32f1-c6be-41e0-8d97-8ad18bae47e7"
          },
          {
            "name": "Session Revenue",
            "description": "Session Revenue",
            "displayFolder": "99 Validation",
            "expression": "SUM(Sessions[revenue_inr])",
            "formatString": "\"₹\"#,0",
            "lineageTag": "d75c849e-c6c0-4475-8ec0-1dd3b0508ee8"
          },
          {
            "name": "Revenue Reconciliation Difference",
            "description": "Revenue Reconciliation Difference",
            "displayFolder": "99 Validation",
            "expression": "[Total Revenue] - [Session Revenue]",
            "formatString": "\"₹\"#,0.00",
            "lineageTag": "7024f059-4c5f-4edf-b98d-108223a73d5c"
          },
          {
            "name": "Revenue Previous Period",
            "description": "Revenue Previous Period",
            "displayFolder": "02 Comparison",
            "expression": [
              "VAR StartD = MIN('Date'[Date])",
              "VAR EndD = MAX('Date'[Date])",
              "VAR DaysN = DATEDIFF(StartD, EndD, DAY) + 1",
              "VAR EarliestD = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'))",
              "RETURN IF(StartD - DaysN >= EarliestD, CALCULATE([Total Revenue], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartD - DaysN, StartD - 1)))"
            ],
            "formatString": "\"₹\"#,0",
            "lineageTag": "2ad4bd1e-e9f9-42e9-b50a-0b6720652c5f"
          },
          {
            "name": "Revenue Change %",
            "description": "Revenue Change %",
            "displayFolder": "02 Comparison",
            "expression": "DIVIDE([Total Revenue] - [Revenue Previous Period], [Revenue Previous Period])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "020a2284-443b-4e66-9297-412ece27d0e5"
          },
          {
            "name": "Conversion Previous Period",
            "description": "Conversion Previous Period",
            "displayFolder": "02 Comparison",
            "expression": [
              "VAR StartD = MIN('Date'[Date])",
              "VAR EndD = MAX('Date'[Date])",
              "VAR DaysN = DATEDIFF(StartD, EndD, DAY) + 1",
              "VAR EarliestD = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'))",
              "RETURN IF(StartD - DaysN >= EarliestD, CALCULATE([Conversion Rate], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartD - DaysN, StartD - 1)))"
            ],
            "formatString": "0.00%",
            "lineageTag": "bd1b84ee-e2d1-4c50-a46d-e356f16eae4f"
          },
          {
            "name": "Conversion Change pp",
            "description": "Conversion Change pp",
            "displayFolder": "02 Comparison",
            "expression": "IF(NOT ISBLANK([Conversion Previous Period]), 100 * ([Conversion Rate] - [Conversion Previous Period]))",
            "formatString": "+0.00 \"pp\";-0.00 \"pp\";0.00 \"pp\"",
            "lineageTag": "779434ea-947c-41fe-a0a6-60230cf2f660"
          },
          {
            "name": "Date Context",
            "description": "Date Context",
            "displayFolder": "02 Comparison",
            "expression": "\"Session dates · \" & FORMAT(MIN('Date'[Date]), \"dd MMM yyyy\") & \" – \" & FORMAT(MAX('Date'[Date]), \"dd MMM yyyy\")",
            "lineageTag": "b6424dc9-f2b8-4aec-9cce-dfa2e53d9314"
          },
          {
            "name": "Revenue Trend Title",
            "description": "Revenue Trend Title",
            "displayFolder": "02 Comparison",
            "expression": "\"Revenue trend | \" & FORMAT(MIN('Date'[Date]), \"MMM yyyy\") & \" – \" & FORMAT(MAX('Date'[Date]), \"MMM yyyy\")",
            "lineageTag": "b41348e3-b412-47b0-8bc7-082c384b772f"
          },
          {
            "name": "Product View Sessions",
            "description": "Product View Sessions",
            "displayFolder": "03 Funnel",
            "expression": "SUM(Sessions[viewed_flag])",
            "formatString": "#,0",
            "lineageTag": "efe1f7ed-70ed-49f6-84da-ebeabf6f05d2"
          },
          {
            "name": "Cart Sessions",
            "description": "Cart Sessions",
            "displayFolder": "03 Funnel",
            "expression": "SUM(Sessions[cart_flag])",
            "formatString": "#,0",
            "lineageTag": "3e77f0d5-aadb-466a-a5df-15392e7567cd"
          },
          {
            "name": "Checkout Sessions",
            "description": "Checkout Sessions",
            "displayFolder": "03 Funnel",
            "expression": "SUM(Sessions[checkout_flag])",
            "formatString": "#,0",
            "lineageTag": "10f5d7f9-a7c7-4b1f-b65e-475939f7fa96"
          },
          {
            "name": "Cart Abandonment",
            "description": "Cart Abandonment",
            "displayFolder": "03 Funnel",
            "expression": "DIVIDE([Cart Sessions] - [Purchasing Sessions], [Cart Sessions])",
            "formatString": "0.0%",
            "lineageTag": "903e73fb-cbf2-425d-9e10-34f7811d3fbb"
          },
          {
            "name": "Checkout Abandonment",
            "description": "Checkout Abandonment",
            "displayFolder": "03 Funnel",
            "expression": "DIVIDE([Checkout Sessions] - [Purchasing Sessions], [Checkout Sessions])",
            "formatString": "0.0%",
            "lineageTag": "111a4607-196e-4412-91ec-4d60b85b055d"
          },
          {
            "name": "Funnel Sessions",
            "description": "Funnel Sessions",
            "displayFolder": "03 Funnel",
            "expression": "SWITCH(SELECTEDVALUE('Funnel Stage'[Stage Order]), 1,[Total Sessions], 2,[Product View Sessions], 3,[Cart Sessions], 4,[Checkout Sessions], 5,[Purchasing Sessions])",
            "formatString": "#,0",
            "lineageTag": "436a69a7-4b77-4e75-9f6e-344aca3ad408"
          },
          {
            "name": "Previous Stage Sessions",
            "description": "Previous Stage Sessions",
            "displayFolder": "03 Funnel",
            "expression": "SWITCH(SELECTEDVALUE('Funnel Stage'[Stage Order]), 1,[Total Sessions], 2,[Total Sessions], 3,[Product View Sessions], 4,[Cart Sessions], 5,[Checkout Sessions])",
            "formatString": "#,0",
            "lineageTag": "348de94c-1f48-4b83-8d54-dc5c9a17892a"
          },
          {
            "name": "Stage Conversion",
            "description": "Stage Conversion",
            "displayFolder": "03 Funnel",
            "expression": "DIVIDE([Funnel Sessions], [Previous Stage Sessions])",
            "formatString": "0.0%",
            "lineageTag": "b8f3db7b-1acf-47af-8891-4653112c1625"
          },
          {
            "name": "Stage Drop-off",
            "description": "Stage Drop-off",
            "displayFolder": "03 Funnel",
            "expression": "[Previous Stage Sessions] - [Funnel Sessions]",
            "formatString": "#,0",
            "lineageTag": "89580853-5d38-463f-8d00-647b335d0f0b"
          },
          {
            "name": "Stage Drop-off %",
            "description": "Stage Drop-off %",
            "displayFolder": "03 Funnel",
            "expression": "DIVIDE([Stage Drop-off], [Previous Stage Sessions])",
            "formatString": "0.0%",
            "lineageTag": "3d70cdb1-0749-4d1d-afa7-67826897fdef"
          },
          {
            "name": "Campaign Spend",
            "description": "Full lifetime budget for campaigns with selected sessions. Not prorated by selected dates.",
            "displayFolder": "05 Acquisition",
            "expression": [
              "VAR ActiveCampaigns = FILTER(VALUES(Sessions[campaign_id]), Sessions[campaign_id] <> 0)",
              "RETURN CALCULATE(SUM(Campaigns[campaign_spend]), KEEPFILTERS(TREATAS(ActiveCampaigns, Campaigns[campaign_id])))"
            ],
            "formatString": "\"₹\"#,0",
            "lineageTag": "4d9cf863-e273-4de9-8461-0f4900668571"
          },
          {
            "name": "Diagnostic ROAS",
            "description": "Campaign-attributed revenue / lifetime budget of campaigns active in the selection. Budget is not dated actual spend; this is not verified financial ROAS.",
            "displayFolder": "05 Acquisition",
            "expression": "DIVIDE([Campaign Attributed Revenue], [Campaign Spend])",
            "formatString": "0.00\"x\"",
            "lineageTag": "180065a3-f746-4ec1-8edc-738f523ab731"
          },
          {
            "name": "Conversion Opportunity Score",
            "description": "0–100 diagnostic score. Selected nonzero campaigns define peers; >=100 selected sessions required. 45% conversion gap, 30% checkout loss, 25% relative traffic. Rounded to six decimals before dense ranking. Not predicted uplift.",
            "displayFolder": "05 Acquisition",
            "expression": [
              "VAR PeerIDs = SELECTCOLUMNS(FILTER(ALLSELECTED(Campaigns), Campaigns[campaign_id] <> 0), \"__ID\", Campaigns[campaign_id])",
              "VAR Stats = ADDCOLUMNS(PeerIDs,",
              " \"__Sessions\", VAR IDN = [__ID] RETURN CALCULATE([Total Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Purchases\", VAR IDN = [__ID] RETURN CALCULATE([Purchasing Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Checkout\", VAR IDN = [__ID] RETURN CALCULATE([Checkout Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])))",
              "VAR PeerCVR = DIVIDE(SUMX(Stats, [__Purchases]), SUMX(Stats, [__Sessions]))",
              "VAR PeakTraffic = MAXX(Stats, [__Sessions])",
              "VAR Scores = ADDCOLUMNS(FILTER(Stats, [__Sessions] >= 100), \"__Score\",",
              " VAR CVR = DIVIDE([__Purchases], [__Sessions])",
              " VAR Gap = MIN(1, MAX(0, DIVIDE(PeerCVR - CVR, PeerCVR, 0)))",
              " VAR Loss = DIVIDE([__Checkout] - [__Purchases], [__Checkout], 0)",
              " RETURN ROUND(100 * (0.45 * Gap + 0.30 * Loss + 0.25 * DIVIDE([__Sessions], PeakTraffic, 0)), 6))",
              "VAR CurrentID = SELECTEDVALUE(Campaigns[campaign_id])",
              "VAR CurrentScore = MAXX(FILTER(Scores, [__ID] = CurrentID), [__Score])",
              "RETURN IF(HASONEVALUE(Campaigns[campaign_id]), CurrentScore)"
            ],
            "formatString": "0.0",
            "lineageTag": "34694332-e3b8-476b-8670-048dc80335ef"
          },
          {
            "name": "Campaign Rank",
            "description": "Dense rank across selected campaigns, consistent across chart/table; genuine score ties share a rank.",
            "displayFolder": "05 Acquisition",
            "expression": [
              "VAR PeerIDs = SELECTCOLUMNS(FILTER(ALLSELECTED(Campaigns), Campaigns[campaign_id] <> 0), \"__ID\", Campaigns[campaign_id])",
              "VAR Stats = ADDCOLUMNS(PeerIDs,",
              " \"__Sessions\", VAR IDN = [__ID] RETURN CALCULATE([Total Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Purchases\", VAR IDN = [__ID] RETURN CALCULATE([Purchasing Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Checkout\", VAR IDN = [__ID] RETURN CALCULATE([Checkout Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])))",
              "VAR PeerCVR = DIVIDE(SUMX(Stats, [__Purchases]), SUMX(Stats, [__Sessions]))",
              "VAR PeakTraffic = MAXX(Stats, [__Sessions])",
              "VAR Scores = ADDCOLUMNS(FILTER(Stats, [__Sessions] >= 100), \"__Score\",",
              " VAR CVR = DIVIDE([__Purchases], [__Sessions])",
              " VAR Gap = MIN(1, MAX(0, DIVIDE(PeerCVR - CVR, PeerCVR, 0)))",
              " VAR Loss = DIVIDE([__Checkout] - [__Purchases], [__Checkout], 0)",
              " RETURN ROUND(100 * (0.45 * Gap + 0.30 * Loss + 0.25 * DIVIDE([__Sessions], PeakTraffic, 0)), 6))",
              "VAR CurrentID = SELECTEDVALUE(Campaigns[campaign_id])",
              "VAR CurrentScore = MAXX(FILTER(Scores, [__ID] = CurrentID), [__Score])",
              "RETURN IF(HASONEVALUE(Campaigns[campaign_id]) && NOT ISBLANK(CurrentScore), RANKX(Scores, [__Score], CurrentScore, DESC, DENSE))"
            ],
            "formatString": "0",
            "lineageTag": "d8db5407-1400-4a0a-9acd-fdd760ea50c0"
          },
          {
            "name": "Top 10 Campaign Score",
            "description": "Exactly at most 10 campaigns; campaign ID breaks score ties for display membership only.",
            "displayFolder": "05 Acquisition",
            "expression": [
              "VAR PeerIDs = SELECTCOLUMNS(FILTER(ALLSELECTED(Campaigns), Campaigns[campaign_id] <> 0), \"__ID\", Campaigns[campaign_id])",
              "VAR Stats = ADDCOLUMNS(PeerIDs,",
              " \"__Sessions\", VAR IDN = [__ID] RETURN CALCULATE([Total Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Purchases\", VAR IDN = [__ID] RETURN CALCULATE([Purchasing Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Checkout\", VAR IDN = [__ID] RETURN CALCULATE([Checkout Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])))",
              "VAR PeerCVR = DIVIDE(SUMX(Stats, [__Purchases]), SUMX(Stats, [__Sessions]))",
              "VAR PeakTraffic = MAXX(Stats, [__Sessions])",
              "VAR Scores = ADDCOLUMNS(FILTER(Stats, [__Sessions] >= 100), \"__Score\",",
              " VAR CVR = DIVIDE([__Purchases], [__Sessions])",
              " VAR Gap = MIN(1, MAX(0, DIVIDE(PeerCVR - CVR, PeerCVR, 0)))",
              " VAR Loss = DIVIDE([__Checkout] - [__Purchases], [__Checkout], 0)",
              " RETURN ROUND(100 * (0.45 * Gap + 0.30 * Loss + 0.25 * DIVIDE([__Sessions], PeakTraffic, 0)), 6))",
              "VAR CurrentID = SELECTEDVALUE(Campaigns[campaign_id])",
              "VAR CurrentScore = MAXX(FILTER(Scores, [__ID] = CurrentID), [__Score])",
              "VAR Leaders = TOPN(10, Scores, [__Score], DESC, [__ID], ASC)",
              "RETURN IF(HASONEVALUE(Campaigns[campaign_id]) && COUNTROWS(FILTER(Leaders, [__ID] = CurrentID)) > 0, CurrentScore)"
            ],
            "formatString": "0.0",
            "lineageTag": "e01b2382-62d3-4729-b857-1b153b63e62e"
          },
          {
            "name": "D1 Eligible Visitors",
            "description": "D1 Eligible Visitors",
            "displayFolder": "06 Retention",
            "expression": "SUM(Visitors[eligible_d1])",
            "formatString": "#,0",
            "lineageTag": "4d875c5b-90c8-49eb-aefc-0d2674e914ef"
          },
          {
            "name": "D1 Retained Visitors",
            "description": "D1 Retained Visitors",
            "displayFolder": "06 Retention",
            "expression": "CALCULATE(SUM(Visitors[retained_d1]), KEEPFILTERS(Visitors[eligible_d1] = 1))",
            "formatString": "#,0",
            "lineageTag": "8b7bef53-ef21-4c45-992d-8ada20a73268"
          },
          {
            "name": "D1 Retention",
            "description": "Exact-day repeat visit / visitors with at least 1 days of follow-up, using full observed history. Cohort date, first channel and first device filters apply.",
            "displayFolder": "06 Retention",
            "expression": "DIVIDE([D1 Retained Visitors], [D1 Eligible Visitors])",
            "formatString": "0.00%",
            "lineageTag": "d144e534-a3de-4ed4-885a-e53a977bdb47"
          },
          {
            "name": "D7 Eligible Visitors",
            "description": "D7 Eligible Visitors",
            "displayFolder": "06 Retention",
            "expression": "SUM(Visitors[eligible_d7])",
            "formatString": "#,0",
            "lineageTag": "e4ec237a-12a1-4869-9514-2b85d87dd000"
          },
          {
            "name": "D7 Retained Visitors",
            "description": "D7 Retained Visitors",
            "displayFolder": "06 Retention",
            "expression": "CALCULATE(SUM(Visitors[retained_d7]), KEEPFILTERS(Visitors[eligible_d7] = 1))",
            "formatString": "#,0",
            "lineageTag": "fab5b085-f33a-4130-9d31-146c34b4d026"
          },
          {
            "name": "D7 Retention",
            "description": "Exact-day repeat visit / visitors with at least 7 days of follow-up, using full observed history. Cohort date, first channel and first device filters apply.",
            "displayFolder": "06 Retention",
            "expression": "DIVIDE([D7 Retained Visitors], [D7 Eligible Visitors])",
            "formatString": "0.00%",
            "lineageTag": "73b2a4e9-6436-4c2b-95ad-827fdc5627e0"
          },
          {
            "name": "D30 Eligible Visitors",
            "description": "D30 Eligible Visitors",
            "displayFolder": "06 Retention",
            "expression": "SUM(Visitors[eligible_d30])",
            "formatString": "#,0",
            "lineageTag": "03eb13ab-7bc3-475b-83ec-04e7a97bc4d1"
          },
          {
            "name": "D30 Retained Visitors",
            "description": "D30 Retained Visitors",
            "displayFolder": "06 Retention",
            "expression": "CALCULATE(SUM(Visitors[retained_d30]), KEEPFILTERS(Visitors[eligible_d30] = 1))",
            "formatString": "#,0",
            "lineageTag": "c4e7e0fb-86a1-4b7f-8372-864bc2935bf4"
          },
          {
            "name": "D30 Retention",
            "description": "Exact-day repeat visit / visitors with at least 30 days of follow-up, using full observed history. Cohort date, first channel and first device filters apply.",
            "displayFolder": "06 Retention",
            "expression": "DIVIDE([D30 Retained Visitors], [D30 Eligible Visitors])",
            "formatString": "0.00%",
            "lineageTag": "4b3ebcb8-a156-44ea-9e00-a7be405cd85f"
          },
          {
            "name": "Cohort Visitors",
            "description": "Cohort Visitors",
            "displayFolder": "06 Retention",
            "expression": "COUNTROWS(Visitors)",
            "formatString": "#,0",
            "lineageTag": "c85fb5da-cb52-48fa-91df-f1eea9176082"
          },
          {
            "name": "Cohort Revenue",
            "description": "Full observed lifetime revenue of selected acquisition cohort; not revenue within a selected session date window.",
            "displayFolder": "06 Retention",
            "expression": "SUM(Visitors[lifetime_revenue_inr])",
            "formatString": "\"₹\"#,0",
            "lineageTag": "50e9dafe-e5ca-464e-b9c5-ad038c2a1047"
          },
          {
            "name": "Cohort Conversion",
            "description": "Cohort Conversion",
            "displayFolder": "06 Retention",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Visitors), KEEPFILTERS(Visitors[lifetime_orders] > 0)), [Cohort Visitors])",
            "formatString": "0.00%",
            "lineageTag": "a281930b-2080-4047-9c63-eae4bc82c0f2"
          },
          {
            "name": "Repeat Visitor Share",
            "description": "Repeat Visitor Share",
            "displayFolder": "06 Retention",
            "expression": "DIVIDE(SUM(Visitors[repeat_visitor_flag]), [Cohort Visitors])",
            "formatString": "0.0%",
            "lineageTag": "524b7266-d2ab-4536-b99b-3d5c83771455"
          },
          {
            "name": "Repeat Buyer Share",
            "description": "Repeat Buyer Share",
            "displayFolder": "06 Retention",
            "expression": "DIVIDE(SUM(Visitors[repeat_buyer_flag]), CALCULATE(COUNTROWS(Visitors), KEEPFILTERS(Visitors[lifetime_orders] > 0)))",
            "formatString": "0.0%",
            "lineageTag": "74a7e3d1-5a4f-470f-b86b-b2ebe1edfa13"
          },
          {
            "name": "Monthly Retention",
            "description": "Visitor-weighted retention with complete calendar-month follow-up. Mature months with no returns show 0%; immature months stay blank. Row grand total across offsets intentionally blank.",
            "displayFolder": "06 Retention",
            "expression": [
              "VAR OffsetN = SELECTEDVALUE('Month Offset'[Month Offset])",
              "VAR LastObserved = CALCULATE(MAX('Date'[Date]), REMOVEFILTERS('Date'))",
              "VAR Eligible = FILTER(VALUES(Visitors[visitor_id]), EOMONTH(CALCULATE(MIN(Visitors[first_visit_date])), OffsetN) <= LastObserved)",
              "VAR Denominator = COUNTROWS(Eligible)",
              "VAR ActiveVisitors = CALCULATE(DISTINCTCOUNT('Cohort Activity'[visitor_id]), TREATAS(Eligible, 'Cohort Activity'[visitor_id]), 'Cohort Activity'[month_offset] = OffsetN)",
              "RETURN IF(ISBLANK(OffsetN), BLANK(), DIVIDE(COALESCE(ActiveVisitors, 0), Denominator))"
            ],
            "formatString": "0.0%",
            "lineageTag": "bcc21f96-6b08-4b21-80bc-2342929171b5"
          },
          {
            "name": "Action Center",
            "description": "Action Center",
            "displayFolder": "07 Actions",
            "expression": "IF(ISBLANK([Checkout Abandonment]), \"No checkout sessions in this selection.\", \"Checkout drop-off: \" & FORMAT([Checkout Abandonment],\"0.0%\") & \". Investigate usability, payments, delivery costs and trust. Causes are unverified.\")",
            "lineageTag": "395f9819-a23d-4c9c-b93f-af71f698e0a1"
          },
          {
            "name": "Campaign Action",
            "description": "Campaign Action",
            "displayFolder": "07 Actions",
            "expression": [
              "VAR PeerIDs = SELECTCOLUMNS(FILTER(ALLSELECTED(Campaigns), Campaigns[campaign_id] <> 0), \"__ID\", Campaigns[campaign_id])",
              "VAR Stats = ADDCOLUMNS(PeerIDs,",
              " \"__Sessions\", VAR IDN = [__ID] RETURN CALCULATE([Total Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Purchases\", VAR IDN = [__ID] RETURN CALCULATE([Purchasing Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])),",
              " \"__Checkout\", VAR IDN = [__ID] RETURN CALCULATE([Checkout Sessions], REMOVEFILTERS(Campaigns), TREATAS({IDN}, Campaigns[campaign_id])))",
              "VAR PeerCVR = DIVIDE(SUMX(Stats, [__Purchases]), SUMX(Stats, [__Sessions]))",
              "VAR PeakTraffic = MAXX(Stats, [__Sessions])",
              "VAR Scores = ADDCOLUMNS(FILTER(Stats, [__Sessions] >= 100), \"__Score\",",
              " VAR CVR = DIVIDE([__Purchases], [__Sessions])",
              " VAR Gap = MIN(1, MAX(0, DIVIDE(PeerCVR - CVR, PeerCVR, 0)))",
              " VAR Loss = DIVIDE([__Checkout] - [__Purchases], [__Checkout], 0)",
              " RETURN ROUND(100 * (0.45 * Gap + 0.30 * Loss + 0.25 * DIVIDE([__Sessions], PeakTraffic, 0)), 6))",
              "VAR CurrentID = SELECTEDVALUE(Campaigns[campaign_id])",
              "VAR CurrentScore = MAXX(FILTER(Scores, [__ID] = CurrentID), [__Score])",
              "VAR Leaders = TOPN(1, Scores, [__Score], DESC, [__ID], ASC)",
              "VAR LeaderID = MAXX(Leaders, [__ID])",
              "VAR LeaderName = CALCULATE(SELECTEDVALUE(Campaigns[campaign_name]), REMOVEFILTERS(Campaigns), TREATAS({LeaderID}, Campaigns[campaign_id]))",
              "RETURN IF(COUNTROWS(Leaders) = 0, \"No campaign meets the 100-session threshold.\", \"Investigate \" & LeaderName & \" (score \" & FORMAT(MAXX(Leaders, [__Score]), \"0.0\") & \"). Score indicates opportunity, not proven uplift; ROAS uses lifetime budgets.\")"
            ],
            "lineageTag": "6d03835c-c674-496d-9f6b-256f157e460b"
          },
          {
            "name": "Behavior Action",
            "description": "Behavior Action",
            "displayFolder": "07 Actions",
            "expression": [
              "",
              "\"Session conversion: \"",
              "    & FORMAT([Conversion Rate], \"0.00%\")",
              "    & \"; returning-session share: \"",
              "    & FORMAT([Returning Session Share], \"0.0%\")",
              "    & \". Review landing-page conversion and checkout abandonment to identify potential friction. Causes require further investigation.\""
            ],
            "lineageTag": "7b6967f6-2c1a-43a6-af3a-bbff6a586d78"
          },
          {
            "name": "Retention Action",
            "description": "Retention Action",
            "displayFolder": "07 Actions",
            "expression": "\"Exact-day retention excludes immature visitors; monthly retention counts any return in a month. Cohort revenue covers observed history, not future value.\"",
            "lineageTag": "5f9ba847-24cd-4618-8d4e-3088feec275a"
          },
          {
            "name": "Campaign Detail Title",
            "description": "Campaign Detail Title",
            "displayFolder": "07 Actions",
            "expression": "\"Campaign detail · \" & SELECTEDVALUE(Campaigns[campaign_name], \"select or drill through to one campaign\")",
            "lineageTag": "d2932bb3-42e2-42d9-82ec-e504189152d6"
          },
          {
            "name": "Sessions Comparison",
            "description": "Visually empty when unavailable: returns a zero-width space to prevent empty card dashes. Otherwise compares a complete prior equal-length calendar interval. Use contiguous date ranges.",
            "displayFolder": "02 Comparison",
            "expression": [
              "VAR StartD = MIN('Date'[Date])",
              "VAR EndD = MAX('Date'[Date])",
              "VAR DaysN = DATEDIFF(StartD, EndD, DAY) + 1",
              "VAR EarliestD = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'))",
              "VAR Prior = IF(StartD - DaysN >= EarliestD, CALCULATE([Total Sessions], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartD - DaysN, StartD - 1)))",
              "RETURN IF(ISBLANK(Prior) || Prior = 0, UNICHAR(8203), FORMAT(DIVIDE([Total Sessions] - Prior, Prior), \"+0.0%;-0.0%;0.0%\") & \" vs prior equal-length period\")"
            ],
            "lineageTag": "9a6d9efc-2bf5-4b7a-a3d9-3295c42dbf30"
          },
          {
            "name": "Orders Comparison",
            "description": "Visually empty when unavailable: returns a zero-width space to prevent empty card dashes. Otherwise compares a complete prior equal-length calendar interval. Use contiguous date ranges.",
            "displayFolder": "02 Comparison",
            "expression": [
              "VAR StartD = MIN('Date'[Date])",
              "VAR EndD = MAX('Date'[Date])",
              "VAR DaysN = DATEDIFF(StartD, EndD, DAY) + 1",
              "VAR EarliestD = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'))",
              "VAR Prior = IF(StartD - DaysN >= EarliestD, CALCULATE([Total Orders], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartD - DaysN, StartD - 1)))",
              "RETURN IF(ISBLANK(Prior) || Prior = 0, UNICHAR(8203), FORMAT(DIVIDE([Total Orders] - Prior, Prior), \"+0.0%;-0.0%;0.0%\") & \" vs prior equal-length period\")"
            ],
            "lineageTag": "413e1f5f-ab77-49cd-b264-952a8b07e211"
          },
          {
            "name": "Revenue Comparison",
            "description": "Visually empty when unavailable: returns a zero-width space to prevent empty card dashes. Otherwise compares a complete prior equal-length calendar interval. Use contiguous date ranges.",
            "displayFolder": "02 Comparison",
            "expression": [
              "VAR StartD = MIN('Date'[Date])",
              "VAR EndD = MAX('Date'[Date])",
              "VAR DaysN = DATEDIFF(StartD, EndD, DAY) + 1",
              "VAR EarliestD = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'))",
              "VAR Prior = IF(StartD - DaysN >= EarliestD, CALCULATE([Total Revenue], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartD - DaysN, StartD - 1)))",
              "RETURN IF(ISBLANK(Prior) || Prior = 0, UNICHAR(8203), FORMAT(DIVIDE([Total Revenue] - Prior, Prior), \"+0.0%;-0.0%;0.0%\") & \" vs prior equal-length period\")"
            ],
            "lineageTag": "26bcce17-ba9b-42a2-b397-f8ddc0d80143"
          },
          {
            "name": "AOV Comparison",
            "description": "Visually empty when unavailable: returns a zero-width space to prevent empty card dashes. Otherwise compares a complete prior equal-length calendar interval. Use contiguous date ranges.",
            "displayFolder": "02 Comparison",
            "expression": [
              "VAR StartD = MIN('Date'[Date])",
              "VAR EndD = MAX('Date'[Date])",
              "VAR DaysN = DATEDIFF(StartD, EndD, DAY) + 1",
              "VAR EarliestD = CALCULATE(MIN('Date'[Date]), REMOVEFILTERS('Date'))",
              "VAR Prior = IF(StartD - DaysN >= EarliestD, CALCULATE([Average Order Value], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartD - DaysN, StartD - 1)))",
              "RETURN IF(ISBLANK(Prior) || Prior = 0, UNICHAR(8203), FORMAT(DIVIDE([Average Order Value] - Prior, Prior), \"+0.0%;-0.0%;0.0%\") & \" vs prior equal-length period\")"
            ],
            "lineageTag": "43fb7b1b-c39e-4c47-b27d-22a981f8b554"
          },
          {
            "name": "Conversion Comparison",
            "description": "Visually empty when unavailable: returns a zero-width space to prevent empty card dashes. Otherwise compares a complete prior equal-length calendar interval. Use contiguous date ranges.",
            "displayFolder": "02 Comparison",
            "expression": "IF(ISBLANK([Conversion Previous Period]), UNICHAR(8203), FORMAT([Conversion Change pp], \"+0.00;-0.00;0.00\") & \" pp vs prior equal-length period\")",
            "lineageTag": "3466490d-44cc-4fae-b982-c4f637ce6a17"
          },
          {
            "name": "Product Attributed Revenue",
            "description": "Order value attributed to the one product on its matching purchase event. Not itemized product sales.",
            "displayFolder": "05 Acquisition",
            "expression": "[Total Revenue]",
            "formatString": "\"₹\"#,0",
            "lineageTag": "350d7c80-f69d-4918-b862-ead965207563"
          },
          {
            "name": "Top 5 Product Revenue",
            "description": "Top 5 Product Revenue",
            "displayFolder": "05 Acquisition",
            "expression": "VAR RankP = RANKX(ALLSELECTED(Products[product_name]), [Product Attributed Revenue], , DESC, DENSE) RETURN IF(RankP<=5,[Product Attributed Revenue])",
            "formatString": "\"₹\"#,0",
            "lineageTag": "9e6ec85a-71ed-473e-a12d-7ef5469a69b6"
          },
          {
            "name": "Campaign Attributed Revenue",
            "description": "Completed order revenue for identified campaigns in the session-date context. Excludes campaign ID 0.",
            "displayFolder": "09 Formatting",
            "expression": "CALCULATE([Total Revenue], KEEPFILTERS(Campaigns[campaign_id] <> 0))",
            "formatString": "₹#,0.00",
            "lineageTag": "8808bfa7-3ea0-45f7-b5bc-92cebf1ce9e2"
          },
          {
            "name": "Monthly Retention Background",
            "description": "Discrete retention heatmap; Month 0 neutral; immature blank cells white. Fixed thresholds, not relative to current selection.",
            "displayFolder": "09 Formatting",
            "expression": [
              "VAR RateN = [Monthly Retention]",
              "RETURN SWITCH(TRUE(), ISBLANK(RateN), \"#FFFFFF\", SELECTEDVALUE('Month Offset'[Month Offset]) = 0, \"#E8E3F3\", RateN >= 0.40, \"#57458F\", RateN >= 0.30, \"#7058B8\", RateN >= 0.20, \"#B7A4E5\", RateN >= 0.10, \"#DED5F2\", \"#F2F0FA\")"
            ],
            "lineageTag": "a3871a90-83e1-4d12-96e3-4af2422c7021"
          },
          {
            "name": "Monthly Retention Font",
            "displayFolder": "09 Formatting",
            "expression": [
              "VAR RateN = [Monthly Retention]",
              "RETURN IF(SELECTEDVALUE('Month Offset'[Month Offset]) <> 0 && NOT ISBLANK(RateN) && RateN >= 0.30, \"#FFFFFF\", \"#28253F\")"
            ],
            "lineageTag": "d3eac717-1d54-436a-b706-65a0b24a0dd7"
          },
          {
            "name": "Stage Loss Background",
            "displayFolder": "09 Formatting",
            "expression": [
              "VAR LossN = [Stage Drop-off %]",
              "RETURN SWITCH(TRUE(), ISBLANK(LossN), \"#FFFFFF\", LossN >= 0.60, \"#F7CFB4\", LossN >= 0.40, \"#FBE6CD\", \"#FFFFFF\")"
            ],
            "lineageTag": "2423e4e2-fe6c-4670-8cf6-ce702a4ee1c0"
          }
        ],
